# CaseJog environment. All inference is local/open — no hosted model provider.

# MongoDB connection. Default points at the local Atlas-local container.
# For a real Atlas M0 cluster, paste its SRV URI here.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# Local open embedding model (fastembed, ONNX, CPU). Swap in ONE place.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Database / collection names
CASEJOG_DB=casejog
CASEJOG_COLL=cases
